# Server-only database access. QR status, PSPs, statements, notifications, and
# webhooks go through authenticated API handlers; the browser does not query
# private Supabase tables directly.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
VITE_DYNAMIC_ENVIRONMENT_ID=your-dynamic-environment-id

# Server-only 32-byte key (64 hex characters) used to AES-GCM wrap QR bearer
# capabilities stored in private owner-history and notification rows. Generate
# independently for each environment and keep it in the deployment secret store.
DISBURSE_CAPABILITY_ENCRYPTION_KEY=

# Optional serverless Redis abuse-control layer. Redis stores only short-lived
# hashed rate-limit identifiers; Supabase remains the payment source of truth.
# Configure both values or neither. Keep the standard token server-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Standard Redis/Redis Cloud alternative. Configure this OR the two Upstash
# variables above, never both. Counters contain only hashed identifiers.
REDIS_URL=

# Portable Settlement Proof (PSP)
ENABLE_PSP=0
DISBURSE_PSP_SIGNING_KEY=
PSP_NETWORK_MODE=testnet
PSP_TRUSTED_ISSUER=
PSP_PUBLIC_URL=https://app.disburse.online

# Optional PspVerifier v2 issuance. Keep REQUIRE=0 until the independently
# verified verifier is deployed, its issuer is trusted, and rollout checks pass.
PSP_REQUIRE_ONCHAIN_CLAIM=0
PSP_VERIFIER_V2_ADDRESS=
